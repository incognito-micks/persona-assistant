# Required for live local model requests. Never put real credentials in this example.
AZURE_OPENAI_SERVICE=your-model-service

# Defaults: text deployment "chat", realtime deployment "voice", transcription "transcription".
# Set these only when connecting to existing differently named deployments.
# AZURE_OPENAI_CHATGPT_DEPLOYMENT=chat
# AZURE_OPENAI_REALTIME_DEPLOYMENT=voice
# AZURE_OPENAI_TRANSCRIPTION_DEPLOYMENT=transcription

# Optional local tenant selection; local development uses AzureDeveloperCliCredential.
# AZURE_TENANT_ID=your-tenant-id

# Owner-only administration stays disabled until all owner fields are configured.
# AZURE_CLIENT_APP_ID=your-owner-spa-client-id
# ADMIN_USER_OID=your-owner-object-id

# Emergency operational control, not a visitor-authentication toggle.
# DISABLE_PUBLIC_ACCESS=true
